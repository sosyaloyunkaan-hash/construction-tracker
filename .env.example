# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Required ---

# PostgreSQL connection string (Railway/Neon/Supabase/local).
DATABASE_URL=postgres://user:password@localhost:5432/construction_tracker

# Secret used to sign engineer + admin JWT session cookies.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In production the app refuses to start without this.
JWT_SECRET=

# Password for the /admin panel login. Admin login returns 500 until this is set.
ADMIN_PASSWORD=

# --- Optional ---

# Passwords used when the engineers table is seeded on first run.
# If unset, seeded accounts get the password "changeme" and must be updated.
SEED_PASSWORD_KAAN=
SEED_PASSWORD_EREN=

# Guard for the destructive POST /api/admin/reset endpoint (drops & re-seeds all
# tables). The endpoint is disabled unless this is set and matches ?secret=.
RESET_SECRET=
